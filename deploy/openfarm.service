[Unit]
Description=OpenFarm web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openfarm
Group=openfarm
# Whichever release /srv/openfarm/current points at, read when the service starts: a deploy switches the link
# and restarts (docs/runbooks/deploy.md).
WorkingDirectory=/srv/openfarm/current
EnvironmentFile=/etc/openfarm/app.env
Environment=NODE_ENV=production
# Every moment the farm keeps is UTC; the farm day is worked out from it in Asia/Dhaka by the code, never by the clock.
Environment=TZ=UTC
Environment=HOST=127.0.0.1
Environment=PORT=3001
ExecStart=/usr/bin/node /srv/openfarm/current/server/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
