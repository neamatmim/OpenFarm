# Everything the farm's server needs, and not one secret.
#
# Copy to apps/web/.env and fill in. The Owner holds every value in the password manager;
# the Manager gets operational access only, which means the deploy host and the app, never
# these (Backups and disaster recovery, ticket 24).

# ─ What this is ────────────────────────────────────────────────────────────────────────
# Left unset the app runs as development, which is not what a farm wants.
NODE_ENV=production

# ─ The database ────────────────────────────────────────────────────────────────────────
# Managed PostgreSQL with point-in-time recovery, Singapore region.
DATABASE_URL=postgres://user:password@host:5432/openfarm

# ─ Sign-in ─────────────────────────────────────────────────────────────────────────────
# At least 32 characters, generated, never reused between environments.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://farm.example.com

# ─ Telling people things (ticket 14) ───────────────────────────────────────────────────
# Generated once with `pnpm dlx web-push generate-vapid-keys`. Absent, the farm does not
# push and nothing breaks: the in-app Alert is the record.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
# The farm's SMS gateway, for the Alerts that must reach a phone with no data. Absent, the
# farm sends no text messages and the in-app Alert is still the record. The credentials are
# the Owner's and the bill is the farm's.
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=
# The sender id the provider registered for this farm, where one is needed.
SMS_GATEWAY_FROM=

# ─ The farm's schedule ─────────────────────────────────────────────────────────────────
# The server raises the day's work, sends late-work notices and carries the digest every
# five minutes, whether or not anybody has the app open. Set to "off" only on a second
# server that shares this database, so the schedule runs once; the Owner sees when it last
# ran under Backups.
# OPENFARM_SCHEDULER=off

# ─ Copies of the farm (ticket 15) ──────────────────────────────────────────────────────
# The age *public* key the nightly copy is encrypted to. Public by design: it can encrypt,
# and only the private half — which lives in the password manager and nowhere else — can
# read what it wrote.
BACKUP_AGE_RECIPIENT=age1...
# An rclone remote on a different provider and region from the database. Its own credentials
# live in rclone's config on the backup host, and a copy of that config lives in the password
# manager — without it, no backup can be fetched after the backup host is gone.
BACKUP_DESTINATION=offsite:openfarm
BACKUP_NIGHTLIES_KEPT=90
# How small a copy may be before the job calls it a failure rather than a farm.
BACKUP_MIN_BYTES=4096

# ─ Restoring (the drill, never the live farm) ──────────────────────────────────────────
# The private half of the backup key. Lives in the password manager and is put on a machine
# only for the length of a drill, because it is the one thing that can read a backup.
BACKUP_AGE_IDENTITY=/path/to/backup-key.txt
