# Everything the farm's server needs, and not one secret.
#
# Copy to apps/web/.env and fill in. The Owner holds every value in the password manager, and
# only the Owner deploys: whoever can put code on the server can read all of these, so the
# Manager has no login there (docs/runbooks/deploy.md; Backups and disaster recovery, ticket 24).

# ─ What this is ────────────────────────────────────────────────────────────────────────
# Left unset the app runs as development, which is not what a farm wants.
NODE_ENV=production

# ─ Where the farm is (ADR 0013) ───────────────────────────────────────────────────────
# The ISO 4217 code the farm counts its money in, and the IANA time zone its own day is read
# on. Left out, a farm in Bangladesh: taka and Asia/Dhaka. Set them before the farm keeps its
# first record and never change them after: a farm that did would read every sum and every
# day it already kept differently. A zone the server does not know stops it from starting.
# OPENFARM_CURRENCY=BDT
# OPENFARM_TIME_ZONE=Asia/Dhaka
# The ISO 3166 country a phone number written without its country code is read in (BD). An
# Investor abroad signs in with + and their own country's code either way.
# OPENFARM_COUNTRY=BD
# The month the farm's financial year began in, 1 to 12 (ADR 0016). Left out, July: a farm in
# Bangladesh keeps its books from July to June. When the law moves the year, the Owner records the
# change in the app (Farm settings, Financial year; ADR 0017). Never change this to do it.
# OPENFARM_YEAR_STARTS=7

# ─ The database ────────────────────────────────────────────────────────────────────────
# Managed PostgreSQL with point-in-time recovery, Singapore region. On Vercel,
# use the provider's pooled/PgBouncer URL rather than its direct connection URL.
DATABASE_URL=postgres://user:password@pooled-host:5432/openfarm?sslmode=require

# ─ Sign-in ─────────────────────────────────────────────────────────────────────────────
# At least 32 characters, generated, never reused between environments. The public URL must
# use HTTPS when NODE_ENV=production; TLS terminates at the host's reverse proxy.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://farm.example.com
# The Investor Portal's own address (ADR 0009): a second name with its own certificate, served
# only the portal's paths. Left out, the portal stays at /portal on BETTER_AUTH_URL. In
# development, http://investors.localhost:3001 — browsers send *.localhost to this machine.
PORTAL_URL=https://investors.farm.example.com
# The Owner's own address. Until the farm is set up it is the only one that may open an account,
# and whoever sets the farm up becomes its Owner — so without it, a production server lets
# nobody in rather than whoever finds the address first. Harmless to leave once the farm exists.
OPENFARM_OWNER_EMAIL=owner@example.com

# Vercel only: a different random value of at least 32 characters. Nitro uses it
# to authenticate Vercel's request to the generated schedule endpoint.
CRON_SECRET=

# ─ Telling people things (ticket 14) ───────────────────────────────────────────────────
# Generated once with `pnpm dlx web-push generate-vapid-keys`. Absent, the farm does not
# push and nothing breaks: the in-app Alert is the record.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
# The farm's SMS gateway, for the Alerts that must reach a phone with no data. Absent, the
# farm sends no text messages and the in-app Alert is still the record. The credentials are
# the Owner's and the bill is the farm's.
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=
# The sender id the provider registered for this farm, where one is needed.
SMS_GATEWAY_FROM=
# What the provider's answer says when it took the message, as its documents give it. Many answer 200 with an
# error inside; with this set, a text counts as sent only when the answer says so, and is tried again otherwise.
SMS_GATEWAY_SUCCESS=

# ─ The farm's schedule ─────────────────────────────────────────────────────────────────
# Nitro raises the day's work, sends late-work notices and carries the digest every five
# minutes, whether or not anybody has the app open. Set to "off" only on a deployment that
# shares this database but must not run the schedule; database locking already prevents
# overlapping invocations. The Owner sees when it last ran under Backups.
# OPENFARM_SCHEDULER=off
# The outside watch's check-in address (a healthchecks.io ping, say), told after each whole
# turn. The farm's own alarms run inside the app: a server down or an app dead tells nobody,
# but the watch stops hearing and tells the Owner. Empty, nothing is sent.
# OPENFARM_WATCH_URL=https://hc-ping.com/...

# ─ Copies of the farm (ticket 15) ──────────────────────────────────────────────────────
# The age *public* key the nightly copy is encrypted to. Public by design: it can encrypt,
# and only the private half — which lives in the password manager and nowhere else — can
# read what it wrote.
BACKUP_AGE_RECIPIENT=age1...
# An rclone remote on a different provider and region from the database. Its own credentials
# live in rclone's config on the backup host, and a copy of that config lives in the password
# manager — without it, no backup can be fetched after the backup host is gone.
BACKUP_DESTINATION=offsite:openfarm
BACKUP_NIGHTLIES_KEPT=90
# How small a copy may be before the job calls it a failure rather than a farm.
BACKUP_MIN_BYTES=4096

# ─ Restoring (the drill, never the live farm) ──────────────────────────────────────────
# The private half of the backup key. Lives in the password manager and is put on a machine
# only for the length of a drill, because it is the one thing that can read a backup.
BACKUP_AGE_IDENTITY=/path/to/backup-key.txt
