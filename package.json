{
  "name": "OpenFarm",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "release:check": "pnpm check-types && pnpm test && pnpm build",
    "check-types": "vp run -r check-types",
    "check": "ultracite check",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev",
    "db:push": "vp run --filter @OpenFarm/db db:push",
    "db:studio": "vp run --filter @OpenFarm/db db:studio",
    "db:generate": "vp run --filter @OpenFarm/db db:generate",
    "db:migrate": "vp run --filter @OpenFarm/db db:migrate",
    "db:seed": "pnpm --filter @OpenFarm/api seed",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "backup": "scripts/backup.sh",
    "restore": "scripts/restore.sh",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "fix": "ultracite fix",
    "test": "vp run -r test"
  },
  "dependencies": {
    "@OpenFarm/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@OpenFarm/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "latest",
    "oxlint": "latest",
    "rolldown": "1.2.8",
    "typescript": "catalog:",
    "ultracite": "7.11.1",
    "vite-plus": "0.3.1"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.3.4",
  "intent": {
    "skills": [
      "*"
    ]
  }
}
